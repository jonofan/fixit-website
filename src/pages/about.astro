---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About - FixIt San Diego">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-2xl font-semibold text-gray-900 mb-8">About</h1>

    <!-- Photo Placeholder -->
    <div class="mb-12">
      <div class="bg-gray-100 rounded-lg h-48 flex items-center justify-center">
        <p class="text-gray-500 text-sm">[Photo: Person working on repairs]</p>
      </div>
    </div>

    <div class="prose prose-gray max-w-none">
      <p class="text-gray-700 mb-6">
        FixIt San Diego is a hobby repair service specializing in KitchenAid mixers, electric toothbrushes, and watches. 
        Instead of throwing things away, let's fix them.
      </p>

      <p class="text-gray-700 mb-8">
        This is a by-donation service - pay what you can afford. The goal is to help the community 
        and reduce waste, not to make a profit.
      </p>

      <h2 class="text-lg font-medium text-gray-900 mb-4">What We Do</h2>
      <ul class="space-y-2 mb-8">
        <li class="flex items-start">
          <span class="w-1.5 h-1.5 bg-gray-400 rounded-full mt-2 mr-3 flex-shrink-0"></span>
          <span class="text-gray-700">KitchenAid mixer motor and gear repair</span>
        </li>
        <li class="flex items-start">
          <span class="w-1.5 h-1.5 bg-gray-400 rounded-full mt-2 mr-3 flex-shrink-0"></span>
          <span class="text-gray-700">Electric toothbrush battery replacement</span>
        </li>
        <li class="flex items-start">
          <span class="w-1.5 h-1.5 bg-gray-400 rounded-full mt-2 mr-3 flex-shrink-0"></span>
          <span class="text-gray-700">Watch battery and band repair</span>
        </li>
      </ul>

      <h2 class="text-lg font-medium text-gray-900 mb-4">How It Works</h2>
      <ol class="space-y-2 mb-8">
        <li class="flex items-start">
          <span class="w-5 h-5 bg-gray-100 rounded-full flex items-center justify-center text-xs font-medium text-gray-600 mt-0.5 mr-3 flex-shrink-0">1</span>
          <span class="text-gray-700">Contact us with details about your broken item</span>
        </li>
        <li class="flex items-start">
          <span class="w-5 h-5 bg-gray-100 rounded-full flex items-center justify-center text-xs font-medium text-gray-600 mt-0.5 mr-3 flex-shrink-0">2</span>
          <span class="text-gray-700">We'll let you know if we can fix it</span>
        </li>
        <li class="flex items-start">
          <span class="w-5 h-5 bg-gray-100 rounded-full flex items-center justify-center text-xs font-medium text-gray-600 mt-0.5 mr-3 flex-shrink-0">3</span>
          <span class="text-gray-700">Drop off or arrange pickup</span>
        </li>
        <li class="flex items-start">
          <span class="w-5 h-5 bg-gray-100 rounded-full flex items-center justify-center text-xs font-medium text-gray-600 mt-0.5 mr-3 flex-shrink-0">4</span>
          <span class="text-gray-700">We fix it and return it to you</span>
        </li>
        <li class="flex items-start">
          <span class="w-5 h-5 bg-gray-100 rounded-full flex items-center justify-center text-xs font-medium text-gray-600 mt-0.5 mr-3 flex-shrink-0">5</span>
          <span class="text-gray-700">Pay what you think it's worth</span>
        </li>
      </ol>

      <div class="bg-gray-50 rounded-lg p-6">
        <p class="text-sm text-gray-600">
          <strong>Note:</strong> This is a hobby service. Repairs may take 1-2 weeks depending on parts availability. 
          If something can't be fixed, there's no charge.
        </p>
      </div>
    </div>
  </div>
</Layout>
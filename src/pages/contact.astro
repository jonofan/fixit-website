---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact - FixIt San Diego">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-2xl font-semibold text-gray-900 mb-8">Contact</h1>

    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Contact Form -->
      <div>
        <h2 class="text-lg font-medium text-gray-900 mb-6">Tell us what's broken</h2>
        <form class="space-y-4">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
            <input type="text" id="name" name="name" required
                   class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:ring-1 focus:ring-gray-500 focus:border-gray-500">
          </div>
          
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input type="email" id="email" name="email" required
                   class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:ring-1 focus:ring-gray-500 focus:border-gray-500">
          </div>
          
          <div>
            <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Phone (optional)</label>
            <input type="tel" id="phone" name="phone"
                   class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:ring-1 focus:ring-gray-500 focus:border-gray-500">
          </div>
          
          <div>
            <label for="item-type" class="block text-sm font-medium text-gray-700 mb-1">What needs fixing?</label>
            <select id="item-type" name="item-type" required
                    class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:ring-1 focus:ring-gray-500 focus:border-gray-500">
              <option value="">Select item type</option>
              <option value="kitchenaid-mixer">KitchenAid Stand Mixer</option>
              <option value="electric-toothbrush">Electric Toothbrush</option>
              <option value="watch">Watch</option>
              <option value="other">Other</option>
            </select>
          </div>
          
          <div>
            <label for="brand-model" class="block text-sm font-medium text-gray-700 mb-1">Brand/Model (if known)</label>
            <input type="text" id="brand-model" name="brand-model" placeholder="e.g., KitchenAid Professional 6-Qt"
                   class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:ring-1 focus:ring-gray-500 focus:border-gray-500">
          </div>
          
          <div>
            <label for="problem" class="block text-sm font-medium text-gray-700 mb-1">What's wrong with it?</label>
            <textarea id="problem" name="problem" rows="4" required placeholder="Describe the problem..."
                      class="w-full px-3 py-2 border border-gray-300 rounded text-sm focus:ring-1 focus:ring-gray-500 focus:border-gray-500"></textarea>
          </div>
          
          <button type="submit" 
                  class="w-full bg-gray-900 text-white py-2 px-4 rounded text-sm hover:bg-gray-800 transition-colors">
            Send Message
          </button>
        </form>
      </div>

      <!-- Contact Info -->
      <div class="space-y-8">
        <!-- Photo Placeholder -->
        <div>
          <div class="bg-gray-100 rounded-lg h-48 flex items-center justify-center">
            <p class="text-gray-500 text-sm">[Photo: Contact/workshop info]</p>
          </div>
        </div>

        <!-- Contact Information -->
        <div>
          <h2 class="text-lg font-medium text-gray-900 mb-4">Get in Touch</h2>
          <div class="space-y-3 text-sm">
            <div>
              <p class="font-medium text-gray-900">Email</p>
              <p class="text-gray-600">fixit.sandiego@example.com</p>
            </div>
            
            <div>
              <p class="font-medium text-gray-900">Response Time</p>
              <p class="text-gray-600">Usually within 24 hours</p>
            </div>
            
            <div>
              <p class="font-medium text-gray-900">Service Area</p>
              <p class="text-gray-600">San Diego area pickup/dropoff</p>
            </div>
          </div>
        </div>

        <!-- Quick Info -->
        <div class="bg-gray-50 rounded-lg p-6">
          <h3 class="font-medium text-gray-900 mb-3 text-sm">Before contacting:</h3>
          <ul class="text-xs text-gray-600 space-y-2">
            <li>• Include photos if possible</li>
            <li>• Describe what happened before it broke</li>
            <li>• Let us know your timeline (no rush is fine)</li>
            <li>• Most repairs take 1-2 weeks</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  document.querySelector('form')?.addEventListener('submit', function(e) {
    e.preventDefault();
    alert('Form submitted! (This is a demo - in reality this would send your message)');
  });
</script>
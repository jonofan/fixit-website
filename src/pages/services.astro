---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services - FixIt San Diego">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-2xl font-semibold text-gray-900 mb-8">Services</h1>

    <!-- Services Grid -->
    <div class="grid md:grid-cols-3 gap-8 mb-16">
      <!-- KitchenAid Mixers -->
      <div class="border border-gray-200 rounded-lg p-6">
        <div class="bg-gray-100 rounded h-32 mb-4 flex items-center justify-center">
          <p class="text-gray-500 text-xs">[Photo: KitchenAid mixer repair]</p>
        </div>
        <h2 class="text-lg font-medium text-gray-900 mb-3">KitchenAid Mixers</h2>
        <p class="text-sm text-gray-600 mb-4">
          Motor rebuilds, gear replacement, electrical issues, general maintenance
        </p>
        <h3 class="font-medium text-gray-900 mb-2 text-sm">Common fixes:</h3>
        <ul class="text-xs text-gray-600 space-y-1">
          <li>• Motor not running</li>
          <li>• Grinding gears</li>
          <li>• Bowl not locking</li>
          <li>• Speed control issues</li>
        </ul>
      </div>

      <!-- Electric Toothbrushes -->
      <div class="border border-gray-200 rounded-lg p-6">
        <div class="bg-gray-100 rounded h-32 mb-4 flex items-center justify-center">
          <p class="text-gray-500 text-xs">[Photo: Toothbrush repair]</p>
        </div>
        <h2 class="text-lg font-medium text-gray-900 mb-3">Electric Toothbrushes</h2>
        <p class="text-sm text-gray-600 mb-4">
          Battery replacement, charging issues, motor repair for all major brands
        </p>
        <h3 class="font-medium text-gray-900 mb-2 text-sm">Common fixes:</h3>
        <ul class="text-xs text-gray-600 space-y-1">
          <li>• Won't hold charge</li>
          <li>• Weak vibration</li>
          <li>• Charging base broken</li>
          <li>• Water damage</li>
        </ul>
      </div>

      <!-- Watch Repairs -->
      <div class="border border-gray-200 rounded-lg p-6">
        <div class="bg-gray-100 rounded h-32 mb-4 flex items-center justify-center">
          <p class="text-gray-500 text-xs">[Photo: Watch repair tools]</p>
        </div>
        <h2 class="text-lg font-medium text-gray-900 mb-3">Watch Repairs</h2>
        <p class="text-sm text-gray-600 mb-4">
          Battery replacement, band adjustment, basic movement servicing
        </p>
        <h3 class="font-medium text-gray-900 mb-2 text-sm">Services:</h3>
        <ul class="text-xs text-gray-600 space-y-1">
          <li>• Battery replacement</li>
          <li>• Band adjustment</li>
          <li>• Crown repair</li>
          <li>• Basic cleaning</li>
        </ul>
      </div>
    </div>

    <!-- Pricing -->
    <div class="bg-gray-50 rounded-lg p-8 mb-16">
      <h2 class="text-lg font-medium text-gray-900 mb-4">Pricing</h2>
      <p class="text-gray-700 mb-6">
        This is a by-donation service. Pay what you think the repair was worth and what you can afford.
      </p>
      
      <div class="grid md:grid-cols-3 gap-6 text-sm">
        <div>
          <h3 class="font-medium text-gray-900 mb-2">Suggested Donations</h3>
          <ul class="text-gray-600 space-y-1">
            <li>KitchenAid Mixers: $20-50</li>
            <li>Electric Toothbrushes: $10-25</li>
            <li>Watch Repairs: $5-20</li>
          </ul>
        </div>
        <div>
          <h3 class="font-medium text-gray-900 mb-2">No Fixed Prices</h3>
          <p class="text-gray-600">
            Every donation helps keep this service running. No amount is too small.
          </p>
        </div>
        <div>
          <h3 class="font-medium text-gray-900 mb-2">If We Can't Fix It</h3>
          <p class="text-gray-600">
            No charge for diagnosis if the item can't be repaired economically.
          </p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center">
      <h2 class="text-lg font-medium text-gray-900 mb-4">
        Ready to fix something?
      </h2>
      <a href="/contact" class="bg-gray-900 text-white px-6 py-2 rounded text-sm hover:bg-gray-800 transition-colors">
        Get Started
      </a>
    </div>
  </div>
</Layout>
---
import Layout from '../layouts/Layout.astro';
---

<Layout title="FixIt San Diego">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Hero Section -->
    <div class="py-16 text-center">
      <h1 class="text-3xl md:text-4xl font-semibold text-gray-900 mb-4">
        FixIt San Diego
      </h1>
      <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">
        Repair service for KitchenAid mixers, electric toothbrushes, and watches. Pay what you can.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/contact" class="bg-gray-900 text-white px-6 py-2 rounded text-sm hover:bg-gray-800 transition-colors">
          Get Started
        </a>
        <a href="/services" class="border border-gray-300 text-gray-700 px-6 py-2 rounded text-sm hover:bg-gray-50 transition-colors">
          View Services
        </a>
      </div>
    </div>

    <!-- Photo Placeholder -->
    <div class="mb-16">
      <div class="bg-gray-100 rounded-lg h-64 flex items-center justify-center">
        <p class="text-gray-500 text-sm">[Photo: Workshop or repair in progress]</p>
      </div>
    </div>

    <!-- What We Fix -->
    <div class="mb-16">
      <h2 class="text-xl font-semibold text-gray-900 mb-8 text-center">
        What We Fix
      </h2>
      
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="bg-gray-100 rounded h-32 mb-4 flex items-center justify-center">
            <p class="text-gray-500 text-xs">[Photo: KitchenAid mixer]</p>
          </div>
          <h3 class="font-medium mb-2 text-gray-900">KitchenAid Mixers</h3>
          <p class="text-sm text-gray-600">
            Motor issues, gear problems, general maintenance
          </p>
        </div>
        
        <div class="text-center">
          <div class="bg-gray-100 rounded h-32 mb-4 flex items-center justify-center">
            <p class="text-gray-500 text-xs">[Photo: Electric toothbrush]</p>
          </div>
          <h3 class="font-medium mb-2 text-gray-900">Electric Toothbrushes</h3>
          <p class="text-sm text-gray-600">
            Battery replacement, charging issues
          </p>
        </div>
        
        <div class="text-center">
          <div class="bg-gray-100 rounded h-32 mb-4 flex items-center justify-center">
            <p class="text-gray-500 text-xs">[Photo: Watch repair]</p>
          </div>
          <h3 class="font-medium mb-2 text-gray-900">Watch Repairs</h3>
          <p class="text-sm text-gray-600">
            Battery replacement, band adjustment
          </p>
        </div>
      </div>
    </div>

    <!-- How It Works -->
    <div class="bg-gray-50 rounded-lg p-8 mb-16">
      <h2 class="text-xl font-semibold text-gray-900 mb-6 text-center">
        How It Works
      </h2>
      <div class="grid md:grid-cols-3 gap-6 text-center">
        <div>
          <div class="text-2xl mb-2">1</div>
          <h3 class="font-medium mb-1">Contact</h3>
          <p class="text-sm text-gray-600">Tell us what's broken</p>
        </div>
        <div>
          <div class="text-2xl mb-2">2</div>
          <h3 class="font-medium mb-1">Fix</h3>
          <p class="text-sm text-gray-600">We repair your item</p>
        </div>
        <div>
          <div class="text-2xl mb-2">3</div>
          <h3 class="font-medium mb-1">Donate</h3>
          <p class="text-sm text-gray-600">Pay what you can</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
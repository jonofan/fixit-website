---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services - FixIt San Diego">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Header -->
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-6">
        Our Services
      </h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Specialized repair services focused on quality workmanship and community support.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid lg:grid-cols-3 gap-8 mb-16">
      <!-- KitchenAid Mixers -->
      <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <div class="bg-red-500 p-6 text-center">
          <span class="text-4xl text-white">🥧</span>
          <h2 class="text-2xl font-bold text-white mt-2">KitchenAid Stand Mixers</h2>
        </div>
        <div class="p-6">
          <p class="text-gray-600 mb-6">
            Expert repair and restoration of KitchenAid stand mixers. These workhorses can last decades with proper care.
          </p>
          <h3 class="font-semibold text-gray-800 mb-3">Common Issues We Fix:</h3>
          <ul class="space-y-2 text-sm text-gray-600 mb-6">
            <li class="flex items-center">
              <span class="w-2 h-2 bg-red-400 rounded-full mr-3"></span>
              Motor not running or running slowly
            </li>
            <li class="flex items-center">
              <span class="w-2 h-2 bg-red-400 rounded-full mr-3"></span>
              Gear grinding or stripped gears
            </li>
            <li class="flex items-center">
              <span class="w-2 h-2 bg-red-400 rounded-full mr-3"></span>
              Bowl not locking in place
            </li>
            <li class="flex items-center">
              <span class="w-2 h-2 bg-red-400 rounded-full mr-3"></span>
              Attachments not fitting properly
            </li>
            <li class="flex items-center">
              <span class="w-2 h-2 bg-red-400 rounded-full mr-3"></span>
              General maintenance and tune-ups
            </li>
          </ul>
          <div class="bg-red-50 p-4 rounded-lg">
            <h4 class="font-semibold text-gray-800 mb-2">What to Expect:</h4>
            <p class="text-sm text-gray-600">
              Complete disassembly, cleaning, gear inspection/replacement, motor servicing, and reassembly with testing.
            </p>
          </div>
        </div>
      </div>

      <!-- Electric Toothbrushes -->
      <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <div class="bg-blue-500 p-6 text-center">
          <span class="text-4xl text-white">🦷</span>
          <h2 class="text-2xl font-bold text-white mt-2">Electric Toothbrushes</h2>
        </div>
        <div class="p-6">
          <p class="text-gray-600 mb-6">
            Battery replacements and repairs for all major electric toothbrush brands including Oral-B, Sonicare, and more.
          </p>
          <h3 class="font-semibold text-gray-800 mb-3">Common Issues We Fix:</h3>
          <ul class="space-y-2 text-sm text-gray-600 mb-6">
            <li class="flex items-center">
              <span class="w-2 h-2 bg-blue-400 rounded-full mr-3"></span>
              Won't hold charge or charge at all
            </li>
            <li class="flex items-center">
              <span class="w-2 h-2 bg-blue-400 rounded-full mr-3"></span>
              Weak vibration or no movement
            </li>
            <li class="flex items-center">
              <span class="w-2 h-2 bg-blue-400 rounded-full mr-3"></span>
              Charging base not working
            </li>
            <li class="flex items-center">
              <span class="w-2 h-2 bg-blue-400 rounded-full mr-3"></span>
              Water damage from bathroom humidity
            </li>
            <li class="flex items-center">
              <span class="w-2 h-2 bg-blue-400 rounded-full mr-3"></span>
              Switch or button problems
            </li>
          </ul>
          <div class="bg-blue-50 p-4 rounded-lg">
            <h4 class="font-semibold text-gray-800 mb-2">What to Expect:</h4>
            <p class="text-sm text-gray-600">
              Careful disassembly, battery replacement with quality cells, waterproofing restoration, and full functionality testing.
            </p>
          </div>
        </div>
      </div>

      <!-- Watch Repairs -->
      <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <div class="bg-amber-500 p-6 text-center">
          <span class="text-4xl text-white">⌚</span>
          <h2 class="text-2xl font-bold text-white mt-2">Watch Repairs</h2>
        </div>
        <div class="p-6">
          <p class="text-gray-600 mb-6">
            Basic watch repair services including battery replacement, band adjustment, and minor servicing.
          </p>
          <h3 class="font-semibold text-gray-800 mb-3">Services We Provide:</h3>
          <ul class="space-y-2 text-sm text-gray-600 mb-6">
            <li class="flex items-center">
              <span class="w-2 h-2 bg-amber-400 rounded-full mr-3"></span>
              Battery replacement for quartz watches
            </li>
            <li class="flex items-center">
              <span class="w-2 h-2 bg-amber-400 rounded-full mr-3"></span>
              Watch band adjustment and repair
            </li>
            <li class="flex items-center">
              <span class="w-2 h-2 bg-amber-400 rounded-full mr-3"></span>
              Basic movement cleaning
            </li>
            <li class="flex items-center">
              <span class="w-2 h-2 bg-amber-400 rounded-full mr-3"></span>
              Crown and stem issues
            </li>
            <li class="flex items-center">
              <span class="w-2 h-2 bg-amber-400 rounded-full mr-3"></span>
              Water resistance testing
            </li>
          </ul>
          <div class="bg-amber-50 p-4 rounded-lg">
            <h4 class="font-semibold text-gray-800 mb-2">What to Expect:</h4>
            <p class="text-sm text-gray-600">
              Professional handling, quality replacement parts, and testing to ensure proper timekeeping and functionality.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Process Section -->
    <div class="bg-gray-50 rounded-lg p-8 mb-16">
      <h2 class="text-3xl font-bold text-gray-800 mb-8 text-center">Our Repair Process</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="text-center">
          <div class="w-16 h-16 bg-blue-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white text-2xl">📞</span>
          </div>
          <h3 class="font-semibold text-gray-800 mb-2">Initial Contact</h3>
          <p class="text-sm text-gray-600">
            Reach out with details about your item and the problem you're experiencing.
          </p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white text-2xl">🔍</span>
          </div>
          <h3 class="font-semibold text-gray-800 mb-2">Assessment</h3>
          <p class="text-sm text-gray-600">
            We'll evaluate the item to determine if repair is feasible and cost-effective.
          </p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-purple-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white text-2xl">🔧</span>
          </div>
          <h3 class="font-semibold text-gray-800 mb-2">Repair Work</h3>
          <p class="text-sm text-gray-600">
            Careful, methodical repair using quality parts and proper techniques.
          </p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-orange-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white text-2xl">✅</span>
          </div>
          <h3 class="font-semibold text-gray-800 mb-2">Testing & Return</h3>
          <p class="text-sm text-gray-600">
            Thorough testing to ensure everything works properly before returning your item.
          </p>
        </div>
      </div>
    </div>

    <!-- Donation Info -->
    <div class="bg-gradient-to-r from-green-500 to-blue-600 rounded-lg p-8 text-white text-center">
      <h2 class="text-3xl font-bold mb-4">Pay What You Can</h2>
      <p class="text-lg mb-6 text-green-100">
        Our service operates on a donation basis. Pay what you feel the repair was worth to you and what you can afford.
      </p>
      <div class="grid md:grid-cols-3 gap-6 text-center">
        <div>
          <h3 class="font-semibold mb-2">Suggested Donations</h3>
          <p class="text-sm text-green-100">
            KitchenAid Mixers: $20-50<br>
            Electric Toothbrushes: $10-25<br>
            Watch Repairs: $5-20
          </p>
        </div>
        <div>
          <h3 class="font-semibold mb-2">Every Amount Helps</h3>
          <p class="text-sm text-green-100">
            No amount is too small. Your contribution helps keep this service running for everyone.
          </p>
        </div>
        <div>
          <h3 class="font-semibold mb-2">Community Support</h3>
          <p class="text-sm text-green-100">
            Higher donations help subsidize repairs for those who can't afford to pay as much.
          </p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center mt-16">
      <h2 class="text-3xl font-bold text-gray-800 mb-4">
        Ready to Get Your Item Fixed?
      </h2>
      <p class="text-lg text-gray-600 mb-8">
        Contact us today to discuss your repair needs and get started.
      </p>
      <a href="/contact" class="bg-blue-600 text-white px-8 py-4 rounded-lg font-semibold hover:bg-blue-700 transition-colors text-lg">
        Contact Us Now
      </a>
    </div>
  </div>
</Layout>
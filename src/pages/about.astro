---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About - FixIt San Diego">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Header -->
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-800 mb-6">
        About FixIt San Diego
      </h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        A passion project dedicated to keeping valuable items working and reducing electronic waste in our community.
      </p>
    </div>

    <!-- Story Section -->
    <div class="bg-white rounded-lg shadow-md p-8 mb-12">
      <h2 class="text-2xl font-semibold text-gray-800 mb-6">Our Story</h2>
      <div class="prose prose-lg text-gray-700 max-w-none">
        <p class="mb-4">
          FixIt San Diego started as a hobby born from a love of tinkering and a frustration with our throwaway culture. 
          Too many perfectly repairable items end up in landfills simply because repair costs can exceed replacement costs.
        </p>
        <p class="mb-4">
          What began as fixing friends' and family's devices has grown into a community service. By operating on a 
          donation basis, we can make quality repairs accessible to everyone, regardless of their financial situation.
        </p>
        <p>
          Every successful repair is a small victory against waste and a step toward a more sustainable community.
        </p>
      </div>
    </div>

    <!-- Expertise Section -->
    <div class="grid md:grid-cols-2 gap-8 mb-12">
      <div class="bg-blue-50 rounded-lg p-8 border border-blue-100">
        <h2 class="text-2xl font-semibold text-gray-800 mb-6">Our Expertise</h2>
        <div class="space-y-4">
          <div class="flex items-center space-x-3">
            <span class="text-2xl">🥧</span>
            <div>
              <h3 class="font-semibold text-gray-800">KitchenAid Stand Mixers</h3>
              <p class="text-sm text-gray-600">Motor rebuilds, gear replacements, electrical issues</p>
            </div>
          </div>
          <div class="flex items-center space-x-3">
            <span class="text-2xl">🦷</span>
            <div>
              <h3 class="font-semibold text-gray-800">Electric Toothbrushes</h3>
              <p class="text-sm text-gray-600">Battery replacement, charging problems, motor repair</p>
            </div>
          </div>
          <div class="flex items-center space-x-3">
            <span class="text-2xl">⌚</span>
            <div>
              <h3 class="font-semibold text-gray-800">Watch Repair</h3>
              <p class="text-sm text-gray-600">Battery replacement, band adjustment, basic servicing</p>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-green-50 rounded-lg p-8 border border-green-100">
        <h2 class="text-2xl font-semibold text-gray-800 mb-6">Our Values</h2>
        <div class="space-y-4">
          <div>
            <h3 class="font-semibold text-gray-800 mb-2">Community First</h3>
            <p class="text-sm text-gray-600">
              Everyone deserves access to quality repairs, regardless of budget. Pay what you can.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-gray-800 mb-2">Quality Work</h3>
            <p class="text-sm text-gray-600">
              Every repair is done with care and attention to detail. Your items matter to us.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-gray-800 mb-2">Sustainability</h3>
            <p class="text-sm text-gray-600">
              Fixing instead of replacing reduces waste and preserves resources for future generations.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-gray-800 mb-2">Transparency</h3>
            <p class="text-sm text-gray-600">
              Clear communication about what can be fixed, costs involved, and realistic timelines.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- How It Works -->
    <div class="bg-gray-50 rounded-lg p-8 mb-12">
      <h2 class="text-2xl font-semibold text-gray-800 mb-6 text-center">How It Works</h2>
      <div class="grid md:grid-cols-4 gap-6">
        <div class="text-center">
          <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center mx-auto mb-3">
            <span class="text-white font-semibold">1</span>
          </div>
          <h3 class="font-semibold text-gray-800 mb-2">Contact Us</h3>
          <p class="text-sm text-gray-600">Describe your item and the issue you're experiencing</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center mx-auto mb-3">
            <span class="text-white font-semibold">2</span>
          </div>
          <h3 class="font-semibold text-gray-800 mb-2">Assessment</h3>
          <p class="text-sm text-gray-600">We'll evaluate if the repair is feasible and worthwhile</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center mx-auto mb-3">
            <span class="text-white font-semibold">3</span>
          </div>
          <h3 class="font-semibold text-gray-800 mb-2">Repair</h3>
          <p class="text-sm text-gray-600">Careful repair work with quality parts when needed</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center mx-auto mb-3">
            <span class="text-white font-semibold">4</span>
          </div>
          <h3 class="font-semibold text-gray-800 mb-2">Donate</h3>
          <p class="text-sm text-gray-600">Pay what you feel the service was worth to you</p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center">
      <h2 class="text-2xl font-semibold text-gray-800 mb-4">
        Ready to Give Your Items a Second Life?
      </h2>
      <p class="text-gray-600 mb-8">
        Let's work together to fix what's broken and keep valuable items out of the landfill.
      </p>
      <a href="/contact" class="bg-blue-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-blue-700 transition-colors">
        Get in Touch
      </a>
    </div>
  </div>
</Layout>